function applyPodcastSimilarityPatch20261025() {
  const spreadsheet = SpreadsheetApp.getActiveSpreadsheet();
  const sheet = spreadsheet.getSheetByName("Ark1");
  if (!sheet) throw new Error('Expected sheet "Ark1" was not found. No changes were made.');

  const lastRow = sheet.getLastRow();
  if (lastRow < 2) throw new Error("Ark1 has no podcast data rows. No changes were made.");
  const ids = sheet.getRange(1, 22, lastRow, 1).getDisplayValues();
  const values = sheet.getRange(1, 20, lastRow, 1).getValues();
  const rowsById = new Map();
  for (let index = 1; index < ids.length; index += 1) {
    const id = String(ids[index][0] || "").trim();
    if (!id) continue;
    const rows = rowsById.get(id) || [];
    rows.push(index + 1);
    rowsById.set(id, rows);
  }

  const conflicts = [];
  const pending = [];
  for (const edit of PODCAST_SIMILARITY_PATCH_20261025) {
    const rows = rowsById.get(edit.podcastId) || [];
    if (rows.length !== 1) {
      conflicts.push(`${edit.podcastId}: expected one row in V, found ${rows.length}`);
      continue;
    }
    const row = rows[0];
    const current = values[row - 1][0] == null ? "" : String(values[row - 1][0]);
    if (current === edit.after) continue;
    if (current !== edit.before) {
      conflicts.push(`${edit.podcastId} (row ${row}): T differs from the approved before-value`);
      continue;
    }
    pending.push({ ...edit, row, current });
  }
  if (conflicts.length) {
    throw new Error(`Preflight conflict; no Sheet writes were made:\n${conflicts.join("\n")}`);
  }
  if (!pending.length) {
    return { status: "already_applied", changed: 0, total: PODCAST_SIMILARITY_PATCH_20261025.length };
  }

  const baseBackupName = "Backup supplerende ligheder 2026-10-25";
  let backupName = baseBackupName;
  let suffix = 2;
  while (spreadsheet.getSheetByName(backupName)) {
    backupName = `${baseBackupName} (${suffix})`;
    suffix += 1;
  }
  const backup = spreadsheet.insertSheet(backupName);
  const backupRows = [["Kilde-række", "Podcast-ID", "Podcast", "T før ændring", "T efter ændring"]];
  pending.forEach((edit) => backupRows.push([edit.row, edit.podcastId, edit.title, edit.current, edit.after]));
  backup.getRange(1, 1, backupRows.length, backupRows[0].length).setValues(backupRows);
  SpreadsheetApp.flush();

  // All rows passed the complete preflight above. Only the individual T cells are written.
  pending.forEach((edit) => sheet.getRange(edit.row, 20).setValue(edit.after));
  SpreadsheetApp.flush();
  return { status: "applied", changed: pending.length, total: PODCAST_SIMILARITY_PATCH_20261025.length, backupSheet: backupName };
}
